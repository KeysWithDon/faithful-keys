# Public DNS name that resolves to this VM. For an Oracle public IP of
# 203.0.113.10, `203.0.113.10.nip.io` is a practical no-registration option.
WORKER_DOMAIN=replace-with-public-ip.nip.io

# Server-only value: never put this in a Vite variable or commit this file.
ANALYSIS_WORKER_TOKEN=replace-with-a-long-random-shared-token
YTDLP_PATH=/usr/local/bin/yt-dlp
DENO_PATH=/usr/local/bin/deno
YTDLP_POT_PROVIDER_HOME=/opt/bgutil-ytdlp-pot-provider/server
# Optional local SOCKS route when YouTube challenges the VM's public IP.
YOUTUBE_PROXY=http://127.0.0.1:40001

CHORD_RECOGNIZER_HOME=/opt/chordmini
CHORD_RECOGNIZER_CHECKPOINT=/opt/chordmini/checkpoints/2e1d_model_best.pth
